{
  "xsappname" : "MYCAPAPP", 
  "scopes"     : [ { 
                    "name" : "$XSAPPNAME.Display", 
                    "description" : "display" }, 
                   { 
                    "name" : "$XSAPPNAME.Edit", 
                    "description" : "edit" }, 
                   { 
                    "name" : "$XSAPPNAME.Delete", 
                    "description": "delete",
                    "granted-apps": ["$XSAPPNAME(application,business-partner)"]
                   }
                ],
 "attributes" : [ { 
                    "name" : "Govardhan", 
                    "description" : "Bank Name which will control row level security", 
                    "valueType" : "string" 
                  }
                   
                 ], 
 "role-templates": [ { 
                    "name"                : "Viewer", 
                    "description"         : "View all data of PO and Employee", 
                    "default-role-name": "Viewer: Authorized to Read All  PO and Employee",
                    "scope-references"    : [ 
                                         "$XSAPPNAME.Display" ], 
                    "attribute-references": [
                                            {
                                            "name" : "Govardhan"
                                            }
                                            ]  
                    }, 
                   { 
                    "name"               : "Editor", 
                    "description"        : "Edit, delete  PO and Employee", 
                    "scope-references"   : [ 
                                          "$XSAPPNAME.Edit", 
                                          "$XSAPPNAME.Delete" ]
                    } 
                   ],
 "authorities":["$ACCEPT_GRANTED_AUTHORITIES"],
 "oauth2-configuration": {
                    "token-validity": 9000, 
                    "redirect-uris": ["https://*.cf.us10-001.hana.ondemand.com" ], 
                    "credential-types": ["binding-secret","x509"]
 },
 "xsenableasyncservice":"true"
}
